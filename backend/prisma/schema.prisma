// ═══════════════════════════════════════════════════════════
// Dynamic Dropdown Options (user-expandable, per-project)
// ═══════════════════════════════════════════════════════════

model DropdownOption {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  type      String // e.g., "VENDOR_CATEGORY", "UNIT", "LOCATION", "EXPENSE_TYPE", "ISSUE_CATEGORY"
  value     String // The stored value
  label     String? // Display label (defaults to value if null)
  isActive  Boolean  @default(true)
  createdBy String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id])
  user    User    @relation("DropdownOptionCreatedBy", fields: [createdBy], references: [id])

  @@unique([projectId, type, value])
  @@index([projectId, type])
  @@map("dropdown_options")
}

// ═══════════════════════════════════════════════════════════
// Attachments (generic image/document uploads linked to any entity)
// ═══════════════════════════════════════════════════════════

model Attachment {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @db.Uuid
  entityType  String // e.g., "VENDOR", "GATE_PASS", "INVENTORY_ITEM", "PURCHASE_ORDER"
  entityId    String   @db.Uuid
  fileName    String
  filePath    String // Storage path/URL
  mimeType    String
  fileType    String // "IMAGE" or "DOCUMENT"
  description String?
  uploadedBy  String   @db.Uuid
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id])
  user    User    @relation("AttachmentUploadedBy", fields: [uploadedBy], references: [id])

  @@index([entityType, entityId])
  @@index([projectId])
  @@map("attachments")
}

// ═══════════════════════════════════════════════════════════
// Push Notifications (FCM tokens for Web Push)
// ═══════════════════════════════════════════════════════════

model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique // FCM registration token
  userAgent String? // browser/device info for identification
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// ═══════════════════════════════════════════════════════════
// Finance Module — Budget Heads, Bank, Cash (Phase 1)
// ═══════════════════════════════════════════════════════════

model BudgetHead {
  id              String   @id @default(uuid()) @db.Uuid
  projectId       String   @db.Uuid
  slNo            Int
  particulars     String
  allocatedAmount Decimal  @db.Decimal(15, 2)
  // Cached derived amounts — NEVER user-edited. Updated only by financial posting ops.
  committedAmount Decimal  @default(0) @db.Decimal(15, 2) // from approved POs not yet invoiced
  actualAmount    Decimal  @default(0) @db.Decimal(15, 2) // from verified invoices + JV expense entries
  paidAmount      Decimal  @default(0) @db.Decimal(15, 2) // from posted payments + JV cash movements
  status          String   @default("ACTIVE") // BudgetHeadStatus enum
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  project  Project    @relation(fields: [projectId], references: [id])
  payments Payment[]
  journalEntries JournalEntry[]
  paymentRequests PaymentRequest[]
  purchaseOrders  PurchaseOrder[]
  revisions       BudgetRevision[]

  @@unique([projectId, slNo])
  @@index([projectId])
  @@map("budget_heads")
}

// ═══════════════════════════════════════════════════════════
// Finance Module — Budget Revisions (Phase 6: edit approval + history)
// ═══════════════════════════════════════════════════════════
model BudgetRevision {
  id              String   @id @default(uuid()) @db.Uuid
  projectId       String   @db.Uuid
  budgetHeadId    String   @db.Uuid
  // Snapshot of values BEFORE the revision
  oldSlNo         Int?
  oldParticulars  String?
  oldAllocated    Decimal? @db.Decimal(15, 2)
  oldStatus       String?
  // Proposed/new values
  newSlNo         Int?
  newParticulars  String?
  newAllocated    Decimal? @db.Decimal(15, 2)
  newStatus       String?
  // Revision metadata
  reason          String   // why the edit was requested
  status          String   @default("PENDING") // PENDING | APPROVED | REJECTED | APPLIED
  requestedBy     String   @db.Uuid
  requestedAt     DateTime @default(now())
  reviewedBy      String?  @db.Uuid
  reviewedAt      DateTime?
  reviewComments  String?
  appliedAt       DateTime? // when the change was actually applied to the budget head
  createdAt       DateTime @default(now())

  project      Project      @relation(fields: [projectId], references: [id])
  budgetHead   BudgetHead   @relation(fields: [budgetHeadId], references: [id], onDelete: Cascade)
  requestedByUser User      @relation("BudgetRevisionRequestedBy", fields: [requestedBy], references: [id])
  reviewedByUser  User?     @relation("BudgetRevisionReviewedBy", fields: [reviewedBy], references: [id])

  @@index([projectId])
  @@index([budgetHeadId])
  @@index([status])
  @@map("budget_revisions")
}

model BankAccount {
  id              String   @id @default(uuid()) @db.Uuid
  projectId       String   @db.Uuid
  accountName     String
  bankName        String?
  accountNumber   String?
  ifscCode        String?
  openingBalance  Decimal  @default(0) @db.Decimal(15, 2)
  currentBalance  Decimal  @default(0) @db.Decimal(15, 2) // cache — NEVER user-edited
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  project      Project           @relation(fields: [projectId], references: [id])
  transactions BankTransaction[]
  payments     Payment[]

  @@index([projectId])
  @@map("bank_accounts")
}

model BankTransaction {
  id              String   @id @default(uuid()) @db.Uuid
  bankAccountId   String   @db.Uuid
  type            String // BankTxnType enum
  amount          Decimal  @db.Decimal(15, 2)
  balanceAfter    Decimal  @db.Decimal(15, 2) // snapshot at posting time
  date            DateTime @default(now())
  description     String?
  referenceType   String // AccountTxnRefType enum
  referenceId     String?  @db.Uuid
  transferPairId  String?  @db.Uuid // links the two sides of an atomic transfer
  status          String   @default("POSTED") // FinancialTxnStatus enum (POSTED | REVERSED)
  reversalOfId    String?  @db.Uuid // original txn this reverses
  createdBy       String   @db.Uuid
  createdAt       DateTime @default(now())

  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  user        User        @relation("BankTxnCreatedBy", fields: [createdBy], references: [id])

  @@index([bankAccountId, date])
  @@index([referenceType, referenceId])
  @@map("bank_transactions")
}

model CashAccount {
  id              String   @id @default(uuid()) @db.Uuid
  projectId       String   @db.Uuid
  name            String
  openingBalance  Decimal  @default(0) @db.Decimal(15, 2)
  currentBalance  Decimal  @default(0) @db.Decimal(15, 2) // cache — NEVER user-edited
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  project      Project           @relation(fields: [projectId], references: [id])
  transactions CashTransaction[]
  payments     Payment[]

  @@index([projectId])
  @@map("cash_accounts")
}

model CashTransaction {
  id              String   @id @default(uuid()) @db.Uuid
  cashAccountId   String   @db.Uuid
  type            String // CashTxnType enum
  amount          Decimal  @db.Decimal(15, 2)
  balanceAfter    Decimal  @db.Decimal(15, 2) // snapshot at posting time
  date            DateTime @default(now())
  description     String?
  referenceType   String // AccountTxnRefType enum
  referenceId     String?  @db.Uuid
  transferPairId  String?  @db.Uuid // links the two sides of an atomic transfer
  status          String   @default("POSTED") // FinancialTxnStatus enum (POSTED | REVERSED)
  reversalOfId    String?  @db.Uuid // original txn this reverses
  createdBy       String   @db.Uuid
  createdAt       DateTime @default(now())

  cashAccount CashAccount @relation(fields: [cashAccountId], references: [id], onDelete: Cascade)
  user        User        @relation("CashTxnCreatedBy", fields: [createdBy], references: [id])

  @@index([cashAccountId, date])
  @@index([referenceType, referenceId])
  @@map("cash_transactions")
}

// ═══════════════════════════════════════════════════════════
// Finance Module — Journal Vouchers & Owner Account (Phase 2)
// ═══════════════════════════════════════════════════════════

model OwnerAccount {
  id              String   @id @default(uuid()) @db.Uuid
  projectId       String   @db.Uuid
  ownerName       String
  openingBalance  Decimal  @default(0) @db.Decimal(15, 2)
  currentBalance  Decimal  @default(0) @db.Decimal(15, 2)
    // POSITIVE = company owes owner (owner put in more than taken out)
    // NEGATIVE = owner owes company (rare)
    // NEVER user-edited. Updated only by:
    //   - Owner contribution (money into company bank) → currentBalance += amount
    //   - JV with OWNER credit (owner paid vendor directly) → currentBalance += amount
    //   - JV with OWNER debit (company repays owner) → currentBalance -= amount
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  project         Project          @relation(fields: [projectId], references: [id])
  journalEntries  JournalEntry[]

  @@index([projectId])
  @@map("owner_accounts")
}

model JournalVoucher {
  id               String    @id @default(uuid()) @db.Uuid
  projectId        String    @db.Uuid
  jvNumber         String    @unique
  date             DateTime  @default(now())
  description      String?
  type             String // JVType enum: OWNER_EXPENSE | OWNER_REPAYMENT | INTER_ACCOUNT | ADJUSTMENT
  status           String    @default("DRAFT")
    // DRAFT → PENDING_APPROVAL → APPROVED → POSTED
    //         → REJECTED | CANCELLED
  totalDebit       Decimal   @default(0) @db.Decimal(15, 2)
  totalCredit      Decimal   @default(0) @db.Decimal(15, 2)
  postedAt         DateTime?
  postedBy         String?   @db.Uuid
  approvalWorkflowId String? @unique @db.Uuid
  createdBy        String    @db.Uuid
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  project          Project           @relation(fields: [projectId], references: [id])
  approvalWorkflow ApprovalWorkflow? @relation(fields: [approvalWorkflowId], references: [id])
  createdByUser    User              @relation("JVCreatedBy", fields: [createdBy], references: [id])
  postedByUser     User?             @relation("JVPostedBy", fields: [postedBy], references: [id])
  entries          JournalEntry[]

  @@index([projectId])
  @@map("journal_vouchers")
}

model JournalEntry {
  id               String   @id @default(uuid()) @db.Uuid
  journalVoucherId String   @db.Uuid
  accountType      String // JournalAccountType enum: BANK | CASH | OWNER | BUDGET_HEAD
  accountId        String?  @db.Uuid // bank/cash account ID if BANK/CASH
  budgetHeadId     String?  @db.Uuid // if BUDGET_HEAD
  ownerAccountId   String?  @db.Uuid // if OWNER
  debit            Decimal  @default(0) @db.Decimal(15, 2)
  credit           Decimal  @default(0) @db.Decimal(15, 2)
  description      String?

  journalVoucher JournalVoucher @relation(fields: [journalVoucherId], references: [id], onDelete: Cascade)
  budgetHead     BudgetHead?    @relation(fields: [budgetHeadId], references: [id])
  ownerAccount   OwnerAccount?  @relation(fields: [ownerAccountId], references: [id])

  @@index([journalVoucherId])
  @@map("journal_entries")
}
