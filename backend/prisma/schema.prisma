model ContractMilestone {
  id         String    @id @default(uuid()) @db.Uuid
  contractId String    @db.Uuid
  name       String
  dueDate    DateTime?
  amount     Decimal   @db.Decimal(15, 2)
  status     String    @default("PENDING") // MilestoneStatus enum
  createdAt  DateTime  @default(now())
