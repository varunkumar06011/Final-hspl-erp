generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ═══════════════════════════════════════════════════════════
// Auth & Projects
// ═══════════════════════════════════════════════════════════

model User {
  id          String   @id @default(uuid()) @db.Uuid
  firebaseUid String   @unique
  phone       String   @unique
  name        String
  role        String // UserRole enum from shared/enums.ts
  projectId   String?  @db.Uuid
  isActive    Boolean  @default(true)
  pinHash     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project                 Project?               @relation(fields: [projectId], references: [id])
  auditLogs               AuditLog[]
  approvalSteps           ApprovalStep[]
  createdVendors          Vendor[]               @relation("VendorCreatedBy")
  createdQuotations       Quotation[]            @relation("QuotationCreatedBy")
  createdPOs              PurchaseOrder[]        @relation("POCreatedBy")
  editedPOs               PurchaseOrder[]        @relation("POEditedBy")
  createdInvoices         VendorInvoice[]        @relation("InvoiceCreatedBy")
  createdPayments         PaymentRequest[]       @relation("PaymentRequestCreatedBy")
  createdGatePasses       GatePass[]             @relation("GatePassCreatedBy")
  createdGoodsReceipts    GoodsReceipt[]         @relation("GoodsReceiptCreatedBy")
  inspectedGoodsReceipts  GoodsReceipt[]         @relation("GoodsReceiptInspectedBy")
  postedGoodsReceipts     GoodsReceipt[]         @relation("GoodsReceiptPostedBy")
  inventoryTxns           InventoryTransaction[]
  assetsIssuedBy          Asset[]                @relation("AssetIssuedBy")
  assetsLastScannedBy     Asset[]                @relation("AssetLastScannedBy")
  assetMovements          AssetMovement[]        @relation("AssetMovementBy")
  assetScans              AssetScan[]            @relation("AssetScanBy")
  assetMaintenanceSent    AssetMaintenance[]     @relation("AssetMaintenanceSentBy")
  assetMaintenanceCompleted AssetMaintenance[]   @relation("AssetMaintenanceCompletedBy")
  createdPhases           Phase[]                @relation("PhaseCreatedBy")
  createdActivities       Activity[]             @relation("ActivityCreatedBy")
  uploadedPhotos          SitePhoto[]            @relation("PhotoUploadedBy")
  createdIssues           Issue[]                @relation("IssueCreatedBy")
  closedIssues            Issue[]                @relation("IssueClosedBy")
  inspections             Inspection[]           @relation("InspectionInspector")
  createdInspections      Inspection[]           @relation("InspectionCreatedBy")
  uploadedDocuments       Document[]             @relation("DocumentUploadedBy")
  gatePassOtpRequestedFor GatePass[]             @relation("GatePassOtpRequestedFor")
  gatePassOtpApprovedBy   GatePass[]             @relation("GatePassOtpApprovedBy")
  createdContracts        Contract[]             @relation("ContractCreatedBy")
  createdDropdownOptions  DropdownOption[]       @relation("DropdownOptionCreatedBy")
  uploadedAttachments     Attachment[]           @relation("AttachmentUploadedBy")
  markedAttendance        StaffAttendance[]      @relation("AttendanceMarker")
  pushSubscriptions       PushSubscription[]
  bankTransactions        BankTransaction[]      @relation("BankTxnCreatedBy")
  cashTransactions        CashTransaction[]      @relation("CashTxnCreatedBy")
  createdJournalVouchers  JournalVoucher[]       @relation("JVCreatedBy")
  postedJournalVouchers   JournalVoucher[]       @relation("JVPostedBy")
  requestedBudgetRevisions BudgetRevision[]      @relation("BudgetRevisionRequestedBy")
  reviewedBudgetRevisions  BudgetRevision[]      @relation("BudgetRevisionReviewedBy")

  @@map("users")
}

model Project {
  id              String    @id @default(uuid()) @db.Uuid
  name            String
  description     String?
  totalBudget     Decimal   @db.Decimal(15, 2)
  startDate       DateTime
  endDate         DateTime?
  status          String    @default("PLANNED") // ProjectStatus enum
  officeAddress   String?
  hospitalAddress String?
  gstNumber       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  users             User[]
  vendors           Vendor[]
  quotations        Quotation[]
  purchaseOrders    PurchaseOrder[]
  invoices          VendorInvoice[]
  paymentRequests   PaymentRequest[]
  gatePasses        GatePass[]
  goodsReceipts     GoodsReceipt[]
  inventoryItems    InventoryItem[]
  assets            Asset[]
  phases            Phase[]
  photos            SitePhoto[]
  issues            Issue[]
  inspections       Inspection[]
  documents         Document[]
  contracts         Contract[]
  approvalWorkflows ApprovalWorkflow[]
  auditLogs         AuditLog[]
  dropdownOptions   DropdownOption[]
  attachments       Attachment[]
  staff             Staff[]
  budgetHeads       BudgetHead[]
  budgetRevisions   BudgetRevision[]
  bankAccounts      BankAccount[]
  cashAccounts      CashAccount[]
  ownerAccounts     OwnerAccount[]
  journalVouchers   JournalVoucher[]

  @@map("projects")
}

// ═══════════════════════════════════════════════════════════
// Financial Chain
// ═══════════════════════════════════════════════════════════

model Vendor {
  id                 String    @id @default(uuid()) @db.Uuid
  vendorCode         String    @unique
  projectId          String    @db.Uuid
  name               String
  contactPersonName  String?
  contactPersonPhone String?
  referenceBy        String?
  gstNumber          String?
  panNumber          String?
  category           String    @default("OTHER") // VendorCategory enum
  bankName           String?
  bankAccountNumber  String?
  ifscCode           String?
  address            String?
  phone              String?
  email              String?
  status             String    @default("ACTIVE") // VendorStatus enum
  rating             Int       @default(0)
  createdBy          String    @db.Uuid
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  project         Project          @relation(fields: [projectId], references: [id])
  createdByUser   User             @relation("VendorCreatedBy", fields: [createdBy], references: [id])
  quotations      Quotation[]
  purchaseOrders  PurchaseOrder[]
  invoices        VendorInvoice[]
  paymentRequests PaymentRequest[]
  contracts       Contract[]
  activities      Activity[]
  materials       VendorMaterial[]

  @@unique([projectId, name])
  @@map("vendors")
}

model VendorMaterial {
  id        String   @id @default(uuid()) @db.Uuid
  vendorId  String   @db.Uuid
  name      String
  unit      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("vendor_materials")
}

model Quotation {
  id                 String    @id @default(uuid()) @db.Uuid
  projectId          String    @db.Uuid
  vendorId           String    @db.Uuid
  phaseId            String?   @db.Uuid
  quotationNumber    String
  date               DateTime  @default(now())
  status             String    @default("PENDING") // QuotationStatus enum
  totalAmount        Decimal   @default(0) @db.Decimal(15, 2)
  gstAmount          Decimal   @default(0) @db.Decimal(15, 2)
  grandTotal         Decimal   @default(0) @db.Decimal(15, 2)
  notes              String?
  filePath           String?
  fileName           String?
  fileMimeType       String?
  createdBy          String    @db.Uuid
  approvalWorkflowId String?   @unique @db.Uuid
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  project          Project           @relation(fields: [projectId], references: [id])
  vendor           Vendor            @relation(fields: [vendorId], references: [id])
  phase            Phase?            @relation(fields: [phaseId], references: [id])
  createdByUser    User              @relation("QuotationCreatedBy", fields: [createdBy], references: [id])
  items            QuotationItem[]
  purchaseOrders   PurchaseOrder[]
  approvalWorkflow ApprovalWorkflow? @relation(fields: [approvalWorkflowId], references: [id])

  @@unique([projectId, quotationNumber])
  @@map("quotations")
}

model QuotationItem {
  id           String   @id @default(uuid()) @db.Uuid
  quotationId  String   @db.Uuid
  materialName String
  quantity     Decimal  @db.Decimal(10, 2)
  unit         String?
  unitPrice    Decimal  @db.Decimal(15, 2)
  amount       Decimal  @db.Decimal(15, 2)
  gstRate      Decimal  @default(0) @db.Decimal(5, 2)
  createdAt    DateTime @default(now())

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@map("quotation_items")
}

model PurchaseOrder {
  id                 String    @id @default(uuid()) @db.Uuid
  projectId          String    @db.Uuid
  vendorId           String    @db.Uuid
  quotationId        String?   @db.Uuid
  phaseId            String?   @db.Uuid
  poNumber           String
  date               DateTime  @default(now())
  status             String    @default("PENDING") // POStatus enum
  paymentType        String    @default("AFTER_DELIVERY") // POPaymentType enum: ADVANCE | AFTER_DELIVERY | FULL_PAYMENT
  deliveryDate       DateTime?
  totalAmount        Decimal   @default(0) @db.Decimal(15, 2)
  gstAmount          Decimal   @default(0) @db.Decimal(15, 2)
  grandTotal         Decimal   @default(0) @db.Decimal(15, 2)
  notes              String?
  createdBy          String    @db.Uuid
  approvalWorkflowId String?   @unique @db.Uuid
  // Regenerated PO support
  parentPoId         String?   @db.Uuid
  regenerationNumber Int       @default(0) // 0 = original, 1+ = regenerated
  regenerationData   Json?     // snapshot of remaining items for regeneration
  editReason         String?
  editedAt           DateTime?
  editedBy           String?   @db.Uuid
  budgetHeadId       String?   @db.Uuid // Phase 3: cost tagging for commitment tracking
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  project          Project           @relation(fields: [projectId], references: [id])
  vendor           Vendor            @relation(fields: [vendorId], references: [id])
  quotation        Quotation?        @relation(fields: [quotationId], references: [id])
  phase            Phase?            @relation(fields: [phaseId], references: [id])
  createdByUser    User              @relation("POCreatedBy", fields: [createdBy], references: [id])
  editedByUser     User?             @relation("POEditedBy", fields: [editedBy], references: [id])
  parentPo         PurchaseOrder?    @relation("PORegeneration", fields: [parentPoId], references: [id])
  childPos         PurchaseOrder[]   @relation("PORegeneration")
  items            POItem[]
  invoices         VendorInvoice[]
  gatePasses       GatePass[]
  goodsReceipts    GoodsReceipt[]
  advancePaymentRequests PaymentRequest[]
  approvalWorkflow ApprovalWorkflow? @relation(fields: [approvalWorkflowId], references: [id])
  budgetHead          BudgetHead?       @relation(fields: [budgetHeadId], references: [id])

  @@unique([projectId, poNumber])
  @@map("purchase_orders")
}

model POItem {
  id           String   @id @default(uuid()) @db.Uuid
  poId         String   @db.Uuid
  materialName String
  quantity     Decimal  @db.Decimal(10, 2)
  unit         String?
  unitPrice    Decimal  @db.Decimal(15, 2)
  amount       Decimal  @db.Decimal(15, 2)
  gstRate      Decimal  @default(0) @db.Decimal(5, 2)
  createdAt    DateTime @default(now())

  purchaseOrder     PurchaseOrder      @relation(fields: [poId], references: [id], onDelete: Cascade)
  goodsReceiptItems GoodsReceiptItem[]

  @@map("po_items")
}

model VendorInvoice {
  id                 String    @id @default(uuid()) @db.Uuid
  projectId          String    @db.Uuid
  vendorId           String    @db.Uuid
  poId               String?   @db.Uuid
  invoiceCode        String    @unique
  invoiceNumber      String
  date               DateTime  @default(now())
  amount             Decimal   @db.Decimal(15, 2)
  taxAmount          Decimal   @default(0) @db.Decimal(15, 2)
  cgstAmount         Decimal   @default(0) @db.Decimal(15, 2)
  sgstAmount         Decimal   @default(0) @db.Decimal(15, 2)
  igstAmount         Decimal   @default(0) @db.Decimal(15, 2)
  totalAmount        Decimal   @db.Decimal(15, 2)
  advancePaid        Decimal   @default(0) @db.Decimal(15, 2)
  advanceType        String?
  advanceOtherType   String?
  paymentStatus      String    @default("PENDING") // PaymentStatus enum
  stockStatus        String    @default("PENDING") // PENDING | RECEIVED
  deliveryDate       DateTime?
  filePath           String?
  fileName           String?
  fileMimeType       String?
  verificationStatus String    @default("PENDING") // InvoiceVerificationStatus enum
  inventoryAdded     Boolean   @default(false) // true once items added to inventory (via gate pass or payment)
  notes              String?
  createdBy          String    @db.Uuid
  approvalWorkflowId String?   @unique @db.Uuid
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  project          Project           @relation(fields: [projectId], references: [id])
  vendor           Vendor            @relation(fields: [vendorId], references: [id])
  purchaseOrder    PurchaseOrder?    @relation(fields: [poId], references: [id])
  createdByUser    User              @relation("InvoiceCreatedBy", fields: [createdBy], references: [id])
  paymentRequests  PaymentRequest[]
  gatePasses       GatePass[]
  approvalWorkflow ApprovalWorkflow? @relation(fields: [approvalWorkflowId], references: [id])

  @@unique([vendorId, invoiceNumber])
  @@map("vendor_invoices")
}

model PaymentRequest {
  id            String    @id @default(uuid()) @db.Uuid
  projectId     String    @db.Uuid
  invoiceId     String?   @db.Uuid
  poId          String?   @db.Uuid
  vendorId      String?   @db.Uuid
  paymentCode   String    @unique
  requestNumber String
  type          String    @default("INVOICE") // INVOICE | EXPENSE | ADVANCE
  amount        Decimal   @db.Decimal(15, 2)
  status        String    @default("PENDING") // PaymentStatus enum
  paymentMode   String? // PaymentMode enum
  description   String?
  category      String?
  expenseDate   DateTime?
  filePath      String?
  fileName      String?
  fileMimeType  String?
  notes         String?
  budgetHeadId  String?   @db.Uuid // Phase 3: cost tagging
  createdBy     String    @db.Uuid
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  project            Project           @relation(fields: [projectId], references: [id])
  invoice            VendorInvoice?    @relation(fields: [invoiceId], references: [id])
  purchaseOrder      PurchaseOrder?    @relation(fields: [poId], references: [id])
  vendor             Vendor?           @relation(fields: [vendorId], references: [id])
  budgetHead         BudgetHead?       @relation(fields: [budgetHeadId], references: [id])
  createdByUser      User              @relation("PaymentRequestCreatedBy", fields: [createdBy], references: [id])
  payments           Payment[]
  approvalWorkflowId String?           @unique @db.Uuid
  approvalWorkflow   ApprovalWorkflow? @relation(fields: [approvalWorkflowId], references: [id])

  @@unique([projectId, requestNumber])
  @@map("payment_requests")
}

model Payment {
  id               String   @id @default(uuid()) @db.Uuid
  paymentRequestId String   @db.Uuid
  amount           Decimal  @db.Decimal(15, 2)
  date             DateTime @default(now())
  mode             String // PaymentMode enum
  reference        String?
  status           String   @default("PAID") // PaymentStatus enum
  // Finance module links (Phase 1 — account linking; budgetHeadId used in Phase 3)
  bankAccountId    String?  @db.Uuid
  cashAccountId    String?  @db.Uuid
  budgetHeadId     String?  @db.Uuid
  postedAt         DateTime?
  reversalOfId     String?  @db.Uuid
  createdAt        DateTime @default(now())

  paymentRequest PaymentRequest @relation(fields: [paymentRequestId], references: [id])
  bankAccount    BankAccount?   @relation(fields: [bankAccountId], references: [id])
  cashAccount    CashAccount?   @relation(fields: [cashAccountId], references: [id])
  budgetHead     BudgetHead?    @relation(fields: [budgetHeadId], references: [id])

  @@map("payments")
}

// ═══════════════════════════════════════════════════════════
// Approval Engine (generic, reusable)
// ═══════════════════════════════════════════════════════════

model ApprovalWorkflow {
  id             String   @id @default(uuid()) @db.Uuid
  entityType     String // e.g., "PAYMENT_REQUEST", "PERMISSION_REQUEST"
  entityId       String   @db.Uuid
  projectId      String   @db.Uuid
  status         String   @default("CREATED") // ApprovalStatus enum
  currentStep    Int      @default(0)
  minApprovers   Int      @default(2)
  approvalPolicy String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project        Project         @relation(fields: [projectId], references: [id])
  steps          ApprovalStep[]
  paymentRequest PaymentRequest?
  quotation      Quotation?
  purchaseOrder  PurchaseOrder?
  vendorInvoice  VendorInvoice?
  journalVoucher JournalVoucher?

  @@unique([entityType, entityId])
  @@map("approval_workflows")
}

model ApprovalStep {
  id             String    @id @default(uuid()) @db.Uuid
  workflowId     String    @db.Uuid
  stepNumber     Int
  approverRole   String // UserRole enum — which role can approve this step
  approverUserId String?   @db.Uuid
  status         String    @default("PENDING") // ApprovalStepStatus enum
  decidedAt      DateTime?
  comments       String?
  createdAt      DateTime  @default(now())

  workflow     ApprovalWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  approverUser User?            @relation(fields: [approverUserId], references: [id])

  @@map("approval_steps")
}

// ═══════════════════════════════════════════════════════════
// Site Operations
// ═══════════════════════════════════════════════════════════

model GatePass {
  id               String    @id @default(uuid()) @db.Uuid
  projectId        String    @db.Uuid
  poId             String?   @db.Uuid
  invoiceId        String?   @db.Uuid
  gatePassCategory String    @default("MATERIAL")
  visitorPhone     String?
  passNumber       String
  date             DateTime  @default(now())
  visitTime        String?
  visitorName      String?
  purpose          String?
  vehicleType      String?
  vehicleNumber    String?
  driverName       String?
  driverMobile     String?
  materialMovement Boolean   @default(true)
  gatePassType     String    @default("NON_RETURNABLE")
  photoProofPath   String?
  remarks          String?
  status           String    @default("PENDING") // PENDING | APPROVED
  otpCode          String?
  otpRequestedFor  String?   @db.Uuid
  otpApprovedBy    String?   @db.Uuid
  otpApprovedAt    DateTime?
  createdBy        String    @db.Uuid
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  project             Project                @relation(fields: [projectId], references: [id])
  purchaseOrder       PurchaseOrder?         @relation(fields: [poId], references: [id])
  invoice             VendorInvoice?         @relation(fields: [invoiceId], references: [id])
  createdByUser       User                   @relation("GatePassCreatedBy", fields: [createdBy], references: [id])
  otpRequestedForUser User?                  @relation("GatePassOtpRequestedFor", fields: [otpRequestedFor], references: [id])
  otpApprovedByUser   User?                  @relation("GatePassOtpApprovedBy", fields: [otpApprovedBy], references: [id])
  items               GatePassItem[]
  inventoryTxns       InventoryTransaction[]
  goodsReceipts       GoodsReceipt[]

  @@unique([projectId, passNumber])
  @@map("gate_passes")
}

model GatePassItem {
  id           String   @id @default(uuid()) @db.Uuid
  gatePassId   String   @db.Uuid
  materialName String
  quantity     Decimal  @db.Decimal(10, 2)
  unit         String?
  createdAt    DateTime @default(now())

  gatePass GatePass @relation(fields: [gatePassId], references: [id], onDelete: Cascade)

  @@map("gate_pass_items")
}

model GoodsReceipt {
  id            String    @id @default(uuid()) @db.Uuid
  projectId     String    @db.Uuid
  poId          String    @db.Uuid
  gatePassId    String    @db.Uuid
  receiptNumber String
  status        String    @default("PENDING_INSPECTION")
  inspectedBy   String?   @db.Uuid
  inspectedAt   DateTime?
  postedBy      String?   @db.Uuid
  postedAt      DateTime?
  createdBy     String    @db.Uuid
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  project         Project                @relation(fields: [projectId], references: [id])
  purchaseOrder   PurchaseOrder          @relation(fields: [poId], references: [id])
  gatePass        GatePass               @relation(fields: [gatePassId], references: [id])
  createdByUser   User                   @relation("GoodsReceiptCreatedBy", fields: [createdBy], references: [id])
  inspectedByUser User?                  @relation("GoodsReceiptInspectedBy", fields: [inspectedBy], references: [id])
  postedByUser    User?                  @relation("GoodsReceiptPostedBy", fields: [postedBy], references: [id])
  inspection      Inspection?
  items           GoodsReceiptItem[]
  inventoryTxns   InventoryTransaction[]

  @@unique([projectId, receiptNumber])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id              String   @id @default(uuid()) @db.Uuid
  goodsReceiptId  String   @db.Uuid
  poItemId        String?  @db.Uuid
  materialName    String
  unit            String?
  deliveredQty    Decimal  @db.Decimal(10, 2)
  acceptedQty     Decimal  @default(0) @db.Decimal(10, 2)
  rejectedQty     Decimal  @default(0) @db.Decimal(10, 2)
  rejectionReason String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  goodsReceipt GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  poItem       POItem?      @relation(fields: [poItemId], references: [id])

  @@map("goods_receipt_items")
}

model InventoryItem {
  id            String    @id @default(uuid()) @db.Uuid
  projectId     String    @db.Uuid
  name          String
  sku           String?
  category      String?
  unit          String
  itemType      String    @default("CONSUMABLE") // InventoryItemType enum: CONSUMABLE | ASSET
  currentStock  Decimal   @default(0) @db.Decimal(10, 2)
  minStockLevel Decimal   @default(0) @db.Decimal(10, 2)
  location      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  project      Project                @relation(fields: [projectId], references: [id])
  transactions InventoryTransaction[]
  assets       Asset[]

  @@unique([projectId, name])
  @@map("inventory_items")
}

model InventoryTransaction {
  id             String   @id @default(uuid()) @db.Uuid
  itemId         String   @db.Uuid
  gatePassId     String?  @db.Uuid
  goodsReceiptId String?  @db.Uuid
  type           String // InventoryTxnType enum (IN / OUT / ADJUST)
  quantity       Decimal  @db.Decimal(10, 2)
  balanceAfter   Decimal  @db.Decimal(10, 2)
  userId         String   @db.Uuid
  notes          String?
  timestamp      DateTime @default(now())

  inventoryItem InventoryItem @relation(fields: [itemId], references: [id])
  gatePass      GatePass?     @relation(fields: [gatePassId], references: [id])
  goodsReceipt  GoodsReceipt? @relation(fields: [goodsReceiptId], references: [id])
  user          User          @relation(fields: [userId], references: [id])

  @@map("inventory_transactions")
}

// ═══════════════════════════════════════════════════════════
// Asset Tracking (individual unit-level tracking for ASSET-type items)
// ═══════════════════════════════════════════════════════════

model Asset {
  id              String   @id @default(uuid()) @db.Uuid
  projectId       String   @db.Uuid
  inventoryItemId String   @db.Uuid
  assetId         String   @unique // Human-readable: VGH-AST-00001
  serialNumber    String?  @unique // Manufacturer serial (unique when provided)
  status          String   @default("ACTIVE") // AssetStatus enum: ACTIVE | ISSUED | UNDER_MAINTENANCE | RETIRED
  location        String   @default("Main Store")
  issuedToDept    String?
  issuedToPerson  String?
  issuedAt        DateTime?
  issuedBy        String?  @db.Uuid
  notes           String?
  version         Int      @default(1) // Optimistic concurrency
  lastScannedAt   DateTime?
  lastScannedBy   String?  @db.Uuid
  lastScanLocation String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Frozen purchase chain (snapshot at creation — never changes)
  vendorName      String?
  vendorCode      String?
  quotationNumber String?
  quotationDate   DateTime?
  poNumber        String?
  poDate          DateTime?
  poPaymentType   String?
  invoiceNumber   String?
  invoiceDate     DateTime?
  unitPrice       Decimal? @db.Decimal(15, 2)
  gstRate         Decimal? @db.Decimal(5, 2)
  gstAmount       Decimal? @db.Decimal(15, 2)
  totalCost       Decimal? @db.Decimal(15, 2)
  poCreatedBy     String?
  receiptNumber   String?
  receiptDate     DateTime?
  gatePassNumber  String?
  receivedBy      String?
  postedBy        String?

  // Regulatory identifiers (manufacturer's UDI/GTIN — scanned from product label)
  udi             String?  // Unique Device Identifier (CDSCO requirement for Class C/D devices)
  gtin            String?  // Global Trade Item Number (GS1 standard)

  // Warranty & AMC tracking
  warrantyExpiry  DateTime?
  amcVendor       String?
  amcExpiry       DateTime?

  // Depreciation tracking (for accounting / fixed asset register)
  usefulLifeYears Decimal? @db.Decimal(5, 1)   // e.g. 5.0 for a ventilator, 10.0 for a bed
  depreciationMethod String?  // STRAIGHT_LINE | WRITTEN_DOWN_VALUE
  salvageValue    Decimal? @db.Decimal(15, 2)  // Residual value at end of useful life

  // Relations
  project         Project           @relation(fields: [projectId], references: [id])
  inventoryItem   InventoryItem     @relation(fields: [inventoryItemId], references: [id])
  issuedByUser    User?             @relation("AssetIssuedBy", fields: [issuedBy], references: [id])
  lastScannedByUser User?           @relation("AssetLastScannedBy", fields: [lastScannedBy], references: [id])
  movements       AssetMovement[]
  scans           AssetScan[]
  maintenances    AssetMaintenance[]

  @@index([projectId, status])
  @@index([inventoryItemId])
  @@map("assets")
}

model AssetMovement {
  id          String   @id @default(uuid()) @db.Uuid
  assetId     String   @db.Uuid
  type        String // AssetMovementType enum: CREATED | ISSUED | RETURNED | RELOCATED | MAINTENANCE_START | MAINTENANCE_COMPLETE | RETIRED | SCANNED
  fromLocation String?
  toLocation  String?
  fromStatus  String?
  toStatus    String?
  issuedToDept String?
  issuedToPerson String?
  reason      String?
  notes       String?
  userId      String   @db.Uuid
  timestamp   DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user  User  @relation("AssetMovementBy", fields: [userId], references: [id])

  @@index([assetId, timestamp])
  @@map("asset_movements")
}

model AssetScan {
  id          String   @id @default(uuid()) @db.Uuid
  assetId     String   @db.Uuid
  userId      String?  @db.Uuid
  userAgent   String?
  location    String?
  timestamp   DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user  User? @relation("AssetScanBy", fields: [userId], references: [id])

  @@index([assetId, timestamp])
  @@map("asset_scans")
}

model AssetMaintenance {
  id              String   @id @default(uuid()) @db.Uuid
  assetId         String   @db.Uuid
  reason          String
  maintenanceVendor String?
  technician      String?
  notes           String?
  cost            Decimal? @db.Decimal(15, 2)
  sentAt          DateTime @default(now())
  sentBy          String   @db.Uuid
  completedAt     DateTime?
  completedBy     String?  @db.Uuid
  completionNotes String?
  finalCost       Decimal? @db.Decimal(15, 2)

  asset    Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  sentByUser   User @relation("AssetMaintenanceSentBy", fields: [sentBy], references: [id])
  completedByUser User? @relation("AssetMaintenanceCompletedBy", fields: [completedBy], references: [id])

  @@index([assetId, sentAt])
  @@map("asset_maintenances")
}

// ═══════════════════════════════════════════════════════════
// Construction Progress
// ═══════════════════════════════════════════════════════════

model Phase {
  id              String    @id @default(uuid()) @db.Uuid
  projectId       String    @db.Uuid
  name            String
  plannedStart    DateTime?
  plannedEnd      DateTime?
  actualStart     DateTime?
  actualEnd       DateTime?
  budgetAmount    Decimal   @default(0) @db.Decimal(15, 2)
  progressPercent Decimal   @default(0) @db.Decimal(5, 2)
  status          String    @default("NOT_STARTED") // PhaseStatus enum
  createdBy       String    @db.Uuid
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  project        Project         @relation(fields: [projectId], references: [id])
  createdByUser  User            @relation("PhaseCreatedBy", fields: [createdBy], references: [id])
  activities     Activity[]
  quotations     Quotation[]
  purchaseOrders PurchaseOrder[]
  photos         SitePhoto[]

  @@map("phases")
}

model Activity {
  id               String    @id @default(uuid()) @db.Uuid
  phaseId          String    @db.Uuid
  name             String
  plannedStart     DateTime?
  plannedEnd       DateTime?
  actualStart      DateTime?
  actualEnd        DateTime?
  assignedVendorId String?   @db.Uuid
  budgetAmount     Decimal   @default(0) @db.Decimal(15, 2)
  progressPercent  Decimal   @default(0) @db.Decimal(5, 2)
  status           String    @default("NOT_STARTED") // ActivityStatus enum
  dependencies     String? // JSON array of activity IDs
  createdBy        String    @db.Uuid
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  phase          Phase       @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  assignedVendor Vendor?     @relation(fields: [assignedVendorId], references: [id])
  createdByUser  User        @relation("ActivityCreatedBy", fields: [createdBy], references: [id])
  photos         SitePhoto[]

  @@map("activities")
}

model SitePhoto {
  id         String   @id @default(uuid()) @db.Uuid
  projectId  String   @db.Uuid
  phaseId    String?  @db.Uuid
  activityId String?  @db.Uuid
  zone       String?
  imageUrl   String
  caption    String?
  takenAt    DateTime @default(now())
  tag        String   @default("DURING") // PhotoTag enum
  uploadedBy String   @db.Uuid
  createdAt  DateTime @default(now())

  project        Project   @relation(fields: [projectId], references: [id])
  phase          Phase?    @relation(fields: [phaseId], references: [id])
  activity       Activity? @relation(fields: [activityId], references: [id])
  uploadedByUser User      @relation("PhotoUploadedBy", fields: [uploadedBy], references: [id])

  @@map("site_photos")
}

model Issue {
  id              String    @id @default(uuid()) @db.Uuid
  projectId       String    @db.Uuid
  category        String // IssueCategory enum
  severity        String    @default("MEDIUM") // IssueSeverity enum
  title           String
  description     String?
  addressTo       String[] // array of User IDs (the 4 heads + self)
  dateRaised      DateTime  @default(now())
  status          String    @default("OPEN") // IssueStatus enum
  closedAt        DateTime?
  closedBy        String?   @db.Uuid
  closurePhotoUrl String?
  closureNotes    String?
  createdBy       String    @db.Uuid
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  project        Project @relation(fields: [projectId], references: [id])
  createdByUser  User    @relation("IssueCreatedBy", fields: [createdBy], references: [id])
  closedByUser   User?   @relation("IssueClosedBy", fields: [closedBy], references: [id])

  @@index([status])
  @@map("issues")
}

model Inspection {
  id               String    @id @default(uuid()) @db.Uuid
  projectId        String    @db.Uuid
  name             String
  date             DateTime  @default(now())
  scheduledDate    DateTime?
  checklist        Json? // Array of { item, result (PASS/FAIL/N/A) }
  defects          Json? // Array of { description, severity }
  correctiveAction String?
  status           String    @default("SCHEDULED") // InspectionStatus enum
  inspectorId      String    @db.Uuid
  completedDate    DateTime?
  goodsReceiptId   String?   @unique @db.Uuid
  createdBy        String    @db.Uuid
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  project       Project       @relation(fields: [projectId], references: [id])
  goodsReceipt  GoodsReceipt? @relation(fields: [goodsReceiptId], references: [id])
  inspector     User          @relation("InspectionInspector", fields: [inspectorId], references: [id])
  createdByUser User          @relation("InspectionCreatedBy", fields: [createdBy], references: [id])

  @@map("inspections")
}

// ═══════════════════════════════════════════════════════════
// Governance
// ═══════════════════════════════════════════════════════════

model Document {
  id          String    @id @default(uuid()) @db.Uuid
  projectId   String    @db.Uuid
  name        String // name of the document
  description String? // what is this document
