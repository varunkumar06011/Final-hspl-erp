# ═══════════════════════════════════════════════════════════
# Backend Environment Variables
# Copy this file to .env and fill in real values
# ═══════════════════════════════════════════════════════════

NODE_ENV=development
PORT=4000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/hospital_erp?schema=public

# Firebase Admin SDK
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Supabase (for prod storage — optional in dev)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-key

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Storage mode: "local" for dev, "supabase" for prod, "gdrive" = new uploads to Google Drive
# (files saved earlier keep opening from Supabase / the local folder)
STORAGE_MODE=local
# Only needed when STORAGE_MODE=gdrive (same OAuth client as the DB backup; refresh token from scripts/backup/oauth_consent.py)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REFRESH_TOKEN=
# GOOGLE_DRIVE_FILES_FOLDER_ID=
# Moving files saved earlier into Drive: npx tsx scripts/migrate-files-to-drive.ts --dry-run (see CLAUDE.md)
# DRIVE_MIGRATION_STATE=./drive-migration-state.json
# Only needed when STORAGE_MODE=local
# LOCAL_STORAGE_PATH=./uploads

# AI assistant "Miko" and OCR structuring (OpenAI; OCR uses the local parser if omitted). Needs a funded API key: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key
# Miko and OCR always use gpt-5-mini (fixed in code).

# Task Hub integration: approvers see their ERP approvals in Task Hub.
# Same long random secret on both servers; Task Hub's receiver for "approvals changed".
TASKHUB_SYNC_SECRET=
TASKHUB_WEBHOOK_URL=
# ERP web address used in record links (default: first FRONTEND_URL entry)
ERP_PUBLIC_URL=
