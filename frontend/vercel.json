{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    }
  ],
  "rewrites": [
    { "source": "/firebase-messaging-sw.js", "destination": "/firebase-messaging-sw.js" },
    { "source": "/manifest.webmanifest", "destination": "/manifest.webmanifest" },
    { "source": "/icon.svg", "destination": "/icon.svg" },
    { "source": "/icon-maskable.svg", "destination": "/icon-maskable.svg" },
    { "source": "/api/:path*", "destination": "https://hospital-erpbackend-production.up.railway.app/api/:path*" },
    { "source": "/health", "destination": "https://hospital-erpbackend-production.up.railway.app/health" },
    { "source": "/((?!api|health|firebase-messaging-sw.js|manifest.webmanifest|icon.svg|icon-maskable.svg).*)", "destination": "/index.html" }
  ]
}
